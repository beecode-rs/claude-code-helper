{
	"compilerOptions": {
		"composite": true,
		"esModuleInterop": true,
		"lib": [
			"ES2023"
		],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noUncheckedIndexedAccess": true,
		"paths": {
			"#src/*": [
				"./src/*"
			]
		},
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2022",
		"types": [
			"node"
		]
	},
	"include": [
		"electron.vite.config.ts",
		"src/main/**/*",
		"src/preload/**/*",
		"src/shared/**/*"
	]
}
