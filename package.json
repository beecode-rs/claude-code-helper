{
	"name": "usage-pulse",
	"version": "0.1.0",
	"description": "Desktop tracker for Claude and z.ai coding-plan usage limits",
	"license": "MIT",
	"author": "milos",
	"type": "module",
	"main": "./out/main/index.js",
	"scripts": {
		"build": "electron-vite build",
		"dev": "electron-vite dev",
		"lint": "pnpm lint:prettier && pnpm lint:eslint && pnpm lint:json",
		"lint-fix": "pnpm lint-fix:prettier && pnpm lint-fix:eslint && pnpm lint-fix:json",
		"lint-fix:eslint": "eslint ./ --fix",
		"lint-fix:json": "jsonsort -t *.json '!./node_modules' '!./**/.env*'",
		"lint-fix:prettier": "prettier --write '**/*.{js,ts,tsx,html,css}'",
		"lint:eslint": "eslint ./ --quiet --no-error-on-unmatched-pattern",
		"lint:json": "pnpm lint-fix:json -c",
		"lint:prettier": "prettier --check '**/*.{js,ts,tsx,html,css}'",
		"start": "electron-vite preview",
		"typecheck": "pnpm typecheck:node && pnpm typecheck:web",
		"typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
		"typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false"
	},
	"dependencies": {
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^5.2.0",
		"electron": "^43.4.1",
		"electron-vite": "^5.0.0",
		"eslint": "^9.39.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-no-loops": "^0.4.0",
		"eslint-plugin-no-only-tests": "^3.4.0",
		"eslint-plugin-no-relative-import-paths": "^1.6.1",
		"eslint-plugin-sort-keys-fix": "^1.1.2",
		"globals": "^16.5.0",
		"json-sort-cli": "^4.2.1",
		"prettier": "^3.9.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^7.3.6"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"electron",
			"esbuild"
		]
	}
}
